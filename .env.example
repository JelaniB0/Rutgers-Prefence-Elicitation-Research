# OpenAI-compatible inference endpoint, not the URL ending in /api/projects/...
AZURE_OPENAI_ENDPOINT="https://course-planner-ai-resource.services.ai.azure.com/openai/v1"
AZURE_OPENAI_API_KEY=""

# These values are Azure deployment names, which may differ from model names.
# Provision the embedding deployment on the same Azure resource used above.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-3-small"

# Required role assignments. Fill each with a deployment on the endpoint above.
# Startup DAG parsing uses PARSER; the shared client defaults to ORCHESTRATOR.
AZURE_OPENAI_PARSER_DEPLOYMENT=
AZURE_OPENAI_ORCHESTRATOR_DEPLOYMENT=
AZURE_OPENAI_DATA_DEPLOYMENT=
AZURE_OPENAI_CONSTRAINT_DEPLOYMENT=
AZURE_OPENAI_PLANNING_DEPLOYMENT=
AZURE_OPENAI_TRANSCRIPT_DEPLOYMENT=
AZURE_OPENAI_RESPONSE_WRITER_DEPLOYMENT=
